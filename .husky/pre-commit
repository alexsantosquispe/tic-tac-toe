#!/usr/bin/env sh

set -e

# Error handler
on_error() {
  echo ""
  echo "❌ Pre-commit failed${CURRENT_STEP:+ at step: $CURRENT_STEP}"
  echo ""
  exit 1
}
trap 'on_error' ERR

echo "🔍 Running pre-commit checks..."

# 1. Type check
echo "⏳ Checking TypeScript types..."
CURRENT_STEP="typecheck"
pnpm run typecheck
CURRENT_STEP=""

# 2. Linter and formatter
echo "🎨 Running ESLint and Prettier (lint-staged)..."
CURRENT_STEP="lint-staged"
pnpm exec lint-staged
CURRENT_STEP=""

# 3. Tests
echo "🧪 Running tests..."
CURRENT_STEP="tests"
pnpm exec jest --findRelatedTests --passWithNoTests
CURRENT_STEP=""

echo ""
echo "✅ Pre-commit checks passed successfully!"
echo ""