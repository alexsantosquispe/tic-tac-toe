set -e

# Error handler
on_error() {
  echo ""
  echo "❌ Pre-push failed${CURRENT_STEP:+ at step: $CURRENT_STEP}"
  echo ""
  exit 1
}
trap 'on_error' ERR

echo "🔍 Running pre-push checks..."

echo "🧪 Running test coverage..."
CURRENT_STEP="coverage"
pnpm test:coverage
CURRENT_STEP=""

echo "🏗️ Verifying build..."
CURRENT_STEP="build"
pnpm run build
CURRENT_STEP=""

echo "✅ Pre-push checks passed successfully!"
exit 0